<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- App Group: shared UserDefaults between the main app and FoundryWidgets extension.
	     Required for WidgetKit snapshot sharing (AI spend, pulse health, agenda). -->
	<key>com.apple.security.application-groups</key>
	<array>
		<string>group.co.gitwork.foundry</string>
	</array>
</dict>
</plist>
