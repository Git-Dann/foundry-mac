<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<!-- Debug only: unsigned builds can't carry the App Group (Xcode wants a provisioning profile),
     so a local Debug widget can't read the app's snapshot. Release uses FoundryWidgets.entitlements. -->
<dict>
	<key>com.apple.security.app-sandbox</key>
	<true/>
</dict>
</plist>
