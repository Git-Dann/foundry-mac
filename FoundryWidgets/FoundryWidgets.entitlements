<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- App Group: shared UserDefaults with the main Foundry app for WidgetKit snapshots. -->
	<key>com.apple.security.application-groups</key>
	<array>
		<string>group.co.gitwork.foundry</string>
	</array>
	<!-- App Extension sandbox — required for all macOS app extensions. -->
	<key>com.apple.security.app-sandbox</key>
	<true/>
</dict>
</plist>
